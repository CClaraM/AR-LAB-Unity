  noAttemptsStep:
    message: 
    textBlocks:
    - text: 'Has usado todos

        tus intentos.'
      duration: 3
    - text: "El ejercicio finaliz\xF3\nsin resolver el reto."
      duration: 3.5
    dragonSprite: {fileID: 21300000, guid: 7694660a747fe4740a6e5bcdcf6ad96d, type: 3}
