  targetTooCloseStep:
    message: 
    textBlocks:
    - text: "\xA1Ups!\nEl objetivo est\xE1 demasiado\ncerca del ca\xF1\xF3n."
      duration: 4
    - text: "Ubica la isla del objetivo\nfuera del \xE1rea del ca\xF1\xF3n."
      duration: 3.9
    dragonSprite: {fileID: 21300000, guid: 4c3433ad638f7014bb471d6b1764c3d3, type: 3}
