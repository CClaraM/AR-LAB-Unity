    visibleDuration: 3
    autoHide: 1
  placeCannonStep:
    message: 
    textBlocks:
    - text: "Busca una superficie\nplana y enf\xF3cala desde\ndiferentes \xE1ngulos."
      duration: 4.4
    - text: "Cuando sea reconocida,\ntoca el lugar donde quieres\nubicar la isla
        del ca\xF1\xF3n."
      duration: 5.6
    dragonSprite: {fileID: 21300000, guid: 192316d603c837044bfd4e8872a65e9d, type: 3}
    audioClip: {fileID: 8300000, guid: 78d6c28d878d5eb47b5b62f57106e91f, type: 3}
    dragonAnchoredPosition: {x: 280, y: -50}
    dragonSize: {x: 423, y: 545}
    dragonRotationZ: 0
    dragonMirrorHorizontal: 0
    dragonMirrorVertical: 0
    messageAnchoredPosition: {x: -170, y: 190}
    messageSize: {x: 618, y: 365}
    messageRotationZ: 0
    messageBackgroundSprite: {fileID: 21300000, guid: a0ab584ca1b776244953f6a24d42f8a3, type: 3}
    messageMirrorHorizontal: 0
    messageMirrorVertical: 1
    backgroundAnchoredPosition: {x: 0, y: 0}
    backgroundSize: {x: 618, y: 365}
    textAnchoredPosition: {x: -5, y: 18}
    textSize: {x: 618, y: 365}
    textFontSize: 42
    showDelay: 0.25
    visibleDuration: 5
    autoHide: 1
  placeTargetStep:
    message: 
    textBlocks:
    - text: "\xA1Perfecto! Ese ser\xE1 nuestro\npunto de lanzamiento."
      duration: 4.3
    - text: 'Ahora toca la pantalla para

        ubicar la isla del objetivo.'
      duration: 4.5
    - text: "Elige bien el lugar: ser\xE1\nel punto que deber\xE1s\nalcanzar con
        el ca\xF1\xF3n."
      duration: 5.5
    dragonSprite: {fileID: 21300000, guid: ca603b359077bcf4d911f8249a776e53, type: 3}
    audioClip: {fileID: 8300000, guid: 4bed1b0bb233ce04b957b805a7e4d71e, type: 3}
    dragonAnchoredPosition: {x: 60, y: -150}
    dragonSize: {x: 423, y: 545}
    dragonRotationZ: 0
    dragonMirrorHorizontal: 0
    dragonMirrorVertical: 0
    messageAnchoredPosition: {x: -60, y: 240}
    messageSize: {x: 562, y: 332}
    messageRotationZ: 0
    messageBackgroundSprite: {fileID: 21300000, guid: 8bc64cd8f42186c45a77a4983af0e13f, type: 3}
    messageMirrorHorizontal: 0
    messageMirrorVertical: 0
    backgroundAnchoredPosition: {x: 0, y: 0}
    backgroundSize: {x: 562, y: 332}
    textAnchoredPosition: {x: 0, y: 22}
    textSize: {x: 562, y: 332}
    textFontSize: 42
    showDelay: 0.25
    visibleDuration: 3
    autoHide: 1
  readyStep:
    message: 
    textBlocks:
    - text: "\xA1Muy bien! Ahora mira la\nparte inferior de la pantalla.\nAll\xED
        encontrar\xE1s los controles\ndel ca\xF1\xF3n."
      duration: 8
    - text: "Para controlar el lanzamiento,\ndebes ingresar la velocidad\ninicial
        y el \xE1ngulo de disparo."
      duration: 6.8
    - text: "Tambi\xE9n ver\xE1s la distancia\nentre el ca\xF1\xF3n y el objetivo,
        as\xED\nque \xFAsala con cuidado para\nplanear tu lanzaminto."
      duration: 8.1
    - text: 'Recuerda que no tienes

        intentos infinitos.'
      duration: 3.5
    - text: "En la parte superior podr\xE1s\nrevisar cu\xE1ntos intentos te\nquedan
        para resolver el reto."
      duration: 6.1
    dragonSprite: {fileID: 21300000, guid: 9f3f4151652aef44ca868ea7988be00c, type: 3}
    audioClip: {fileID: 8300000, guid: 3c4626c11325d534ab9a836905d007f3, type: 3}
    dragonAnchoredPosition: {x: -252, y: 110}
    dragonSize: {x: 423, y: 545}
