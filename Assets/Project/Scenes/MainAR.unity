  missedTargetStep:
    message: 
    textBlocks:
    - text: "\xA1Oh! El proyectil\nno dio en el blanco."
      duration: 4.3
    - text: "No te preocupes.\nCon un peque\xF1o cambio,"
      duration: 3.8
    - text: "puedes acercarte mucho\nm\xE1s al objetivo."
      duration: 3.4
    dragonSprite: {fileID: 21300000, guid: bff6589e8c5233346b9cd0a530dd42a8, type: 3}
