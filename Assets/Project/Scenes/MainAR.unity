  outOfBoundsStep:
    message: 
    textBlocks:
    - text: "\xA1Cuidado! El proyectil\nsali\xF3 del \xE1rea del objetivo."
      duration: 4.5
    - text: "Revisa la f\xF3rmula,\nluego ajusta la\nvelocidad o el \xE1ngulo\npara
        intentarlo de nuevo."
      duration: 7.2
    dragonSprite: {fileID: 21300000, guid: 4c3433ad638f7014bb471d6b1764c3d3, type: 3}
